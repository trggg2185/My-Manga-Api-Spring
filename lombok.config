# Cho phép Lombok tự động thêm/copy annotation @NonNull vào các method do Lombok sinh ra (bao gồm build())
lombok.copyableAnnotations += org.springframework.lang.NonNull
config.stopBubbling = true
# Yêu cầu Lombok thêm annotation nullability của Spring (hoặc eclipse, checkerframework)
lombok.addNullAnnotations = spring